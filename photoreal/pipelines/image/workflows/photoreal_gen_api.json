{
  "_meta": {
    "title": "photoreal_gen",
    "description": "FLUX.2 Klein 9B Base + Lenovo UltraReal + Mrpopo photoreal (SFW default). API-format ComfyUI workflow.",
    "backbone": "flux-2-klein-base-9b.safetensors",
    "notes": [
      "Place transformer under data/models/flux2/klein-base-9b/ (seen as diffusion_models via extra_model_paths).",
      "Place AE as ae.safetensors in the same folder (vae).",
      "Place Qwen3-8B text encoder file in text_encoder/ (or text_encoders path) — clip_name below must match.",
      "Lenovo strength ~0.85; Mrpopo photoreal ~1.0; FluxGuidance 4.0 for Base."
    ]
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-base-9b.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_8b.safetensors",
      "type": "flux2"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "4": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["2", 0],
      "lora_name": "lenovo_flux_klein9b.safetensors",
      "strength_model": 0.85,
      "strength_clip": 0.85
    }
  },
  "5": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["4", 0],
      "clip": ["4", 1],
      "lora_name": "mrpopo_photorealistic.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["5", 1],
      "text": "PROMPT_PLACEHOLDER"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["5", 1],
      "text": ""
    }
  },
  "8": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["6", 0],
      "guidance": 4.0
    }
  },
  "9": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "seed": 0,
      "steps": 28,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["8", 0],
      "negative": ["7", 0],
      "latent_image": ["9", 0],
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["3", 0]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "photoreal_gen"
    }
  }
}
