{
  "_meta": {
    "title": "wan_animate",
    "description": "Wan2.2 Animate Animation (Move) mode: pose-locked character still + driving video pose/face preprocess → WanAnimateToVideo. No background_video / character_mask.",
    "backbone": "Wan2_2-Animate-14B_fp8_e4m3fn_scaled_KJ.safetensors",
    "notes": [
      "Requires ComfyUI-WanAnimatePreprocess (OnnxDetectionModelLoader, PoseAndFaceDetection, DrawViTPose).",
      "Detection ONNX under models/detection (yolov10m.onnx + vitpose-l-wholebody.onnx).",
      "Default LightX2V distill LoRA: 4–6 steps, cfg ~1.",
      "Chunk length max 77; ImageFromBatch trims continue_motion overlap via WanAnimateToVideo.trim_image.",
      "Output fps matches driving video (prefer 24 fps capture)."
    ]
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "Wan2_2-Animate-14B_fp8_e4m3fn_scaled_KJ.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "6": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["5", 0],
      "shift": 8.0
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "a person moving naturally, photorealistic"
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "blurry, low quality, distorted face, deformed hands"
    }
  },
  "9": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "character.png"
    }
  },
  "10": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["4", 0],
      "image": ["9", 0],
      "crop": "center"
    }
  },
  "11": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "driving.mp4"
    }
  },
  "12": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["11", 0]
    }
  },
  "13": {
    "class_type": "OnnxDetectionModelLoader",
    "inputs": {
      "vitpose_model": "vitpose-l-wholebody.onnx",
      "yolo_model": "yolov10m.onnx",
      "onnx_device": "CUDAExecutionProvider"
    }
  },
  "14": {
    "class_type": "PoseAndFaceDetection",
    "inputs": {
      "model": ["13", 0],
      "images": ["12", 0],
      "width": 832,
      "height": 480,
      "retarget_image": ["9", 0],
      "face_padding": 0
    }
  },
  "15": {
    "class_type": "DrawViTPose",
    "inputs": {
      "pose_data": ["14", 0],
      "width": 832,
      "height": 480,
      "retarget_padding": 16,
      "body_stick_width": -1,
      "hand_stick_width": -1,
      "draw_head": true
    }
  },
  "16": {
    "class_type": "WanAnimateToVideo",
    "inputs": {
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["3", 0],
      "width": 832,
      "height": 480,
      "length": 77,
      "batch_size": 1,
      "continue_motion_max_frames": 5,
      "video_frame_offset": 0,
      "clip_vision_output": ["10", 0],
      "reference_image": ["9", 0],
      "face_video": ["14", 1],
      "pose_video": ["15", 0]
    }
  },
  "17": {
    "class_type": "TrimVideoLatent",
    "inputs": {
      "samples": ["16", 2],
      "trim_amount": ["16", 3]
    }
  },
  "18": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0],
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["16", 0],
      "negative": ["16", 1],
      "latent_image": ["17", 0],
      "denoise": 1.0
    }
  },
  "19": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["18", 0],
      "vae": ["3", 0]
    }
  },
  "25": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": ["19", 0],
      "batch_index": ["16", 4],
      "length": 4096
    }
  },
  "20": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["25", 0],
      "fps": 24.0
    }
  },
  "21": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["20", 0],
      "filename_prefix": "wan_animate/photoreal",
      "format": "auto",
      "codec": "auto"
    }
  }
}
