# Hugging Face (required — enter on portal)
HF_TOKEN=

# Optional — Civitai rate limits
CIVITAI_API_TOKEN=

# Optional — GitHub CLI / Flash deploy via Actions on Windows
# Classic: repo (covers actions:write + secrets). Fine-grained: Actions + Secrets + Contents.
# Save/Launch auto-syncs Actions secrets RUNPOD_API_KEY and HF_TOKEN to the GitHub repo.
GITHUB_TOKEN=

# Required — enter on portal (Runpod Flash)
RUNPOD_API_KEY=
# Optional cache/override — auto-filled after first Generate (name: photoreal-character-4090)
FLASH_CHARACTER_ENDPOINT=
# Set to 1 after volume models are verified complete (auto by Generate / flash_sync_volume.py)
FLASH_VOLUME_SYNCED=
# auto | local | runpod
GENERATE_BACKEND=auto

# Applied via portal Save as git config --local (not written as env by default)
# GIT_USER_NAME=
# GIT_USER_EMAIL=
